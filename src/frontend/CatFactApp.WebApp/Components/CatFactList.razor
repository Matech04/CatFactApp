@using CatFactApp.WebApp.Models
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">📜 Historia faktów</h2>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadCatFacts" disabled="@isLoading">
        🔄 Odśwież
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger shadow-sm" role="alert">
        @errorMessage
    </div>
}

@if (isLoading && (catFacts == null || !catFacts.Any()))
{
    <div class="d-flex align-items-center gap-2 my-4 text-primary">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>Pobieranie listy faktów...</span>
    </div>
}
else if (catFacts != null && catFacts.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var fact in catFacts)
        {
            <div class="card shadow-sm border-start border-4 border-info">
                <div class="card-body">
                    <p class="fs-5 card-text mb-2">"@fact.Fact"</p>
                    <div class="d-flex justify-content-between align-items-center text-muted pt-2 border-top">
                        <small>📅 @fact.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                        <span class="badge bg-secondary">@fact.Length znaków</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (catFacts != null && !catFacts.Any())
{
    <div class="alert alert-info text-center py-4" role="alert">
        <h5>🐱 Brak zapisanych faktów</h5>
        <p class="mb-0">Użyj przycisku powyżej, aby dodać pierwszy wpis!</p>
    </div>
}

@code {
    private List<CatFactDto>? catFacts;
    private bool isLoading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCatFacts();
    }

    public async Task LoadCatFacts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await Http.GetAsync("api/cat-fact");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<CatFactDto>>();
                if (result != null)
                {
                    // Najnowsze fakty na samej górze
                    catFacts = result.AsEnumerable().Reverse().ToList();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                errorMessage = "⚠️ Przekroczono limit zapytań (Rate Limiter). Spróbuj za chwilę!";
            }
            else
            {
                errorMessage = $"Błąd serwera: {(int)response.StatusCode} {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udało się połączyć z API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
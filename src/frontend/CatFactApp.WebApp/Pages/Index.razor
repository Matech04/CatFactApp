@page "/"
@using CatFactApp.WebApp.Components

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4 text-center">🐱 Cat Fact App</h1>

    <!-- Komponent do pobierania faktów -->
    <FetchCatFact OnFactAdded="RefreshList" />

    <!-- Komponent wyświetlający historię -->
    <CatFactList @ref="listComponent" />
</div>

@code {
    private CatFactList? listComponent;

    private async Task RefreshList()
    {
        if (listComponent != null)
        {
            await listComponent.LoadCatFacts();
        }
    }
}